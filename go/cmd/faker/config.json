{
  "service": {
    "name": "faker",
    "description": "ServiceRadar Fake Armis API Service",
    "version": "1.0.0"
  },
  "server": {
    "listen_address": "0.0.0.0:8080",
    "read_timeout": "10s",
    "write_timeout": "30s",
    "idle_timeout": "30s"
  },
  "simulation": {
    "total_devices": 50000,
    "ip_shuffle": {
      "enabled": true,
      "interval": "10m",
      "percentage": 5,
      "warmup_cycles": 2,
      "allow_expansion": true,
      "pool_headroom_percent": 20,
      "log_changes": true
    },
    "bgp": {
      "enabled": false,
      "seed": 40164200,
      "publish_interval": "15s",
      "outage_interval": "2m",
      "outage_duration_min": "20s",
      "outage_duration_max": "45s",
      "manage_daemon": true,
      "gobgp_api_address": "127.0.0.1:50051",
      "gobgp_binary": "gobgpd",
      "gobgp_cli_binary": "gobgp",
      "bmp_collector_address": "127.0.0.1:11019",
      "router_id": "192.0.2.10",
      "max_prefixes_per_tick": 3,
      "local_asn": 4200000001,
      "advertised_prefixes": [
        "198.51.100.0/24",
        "2001:db8::/48"
      ],
      "peers": [
        {"name": "ops-k8s-control", "ip": "10.77.0.42", "peer_asn": 4200000001, "description": "ops-k8s-control"},
        {"name": "dev-k8s-control", "ip": "10.77.0.43", "peer_asn": 4200000001, "description": "dev-k8s-control"},
        {"name": "lab-k8s-control", "ip": "10.77.0.44", "peer_asn": 4200000001, "description": "lab-k8s-control"},
        {"name": "ops-k8s-worker1", "ip": "10.77.0.45", "peer_asn": 4200000001, "description": "ops-k8s-worker1"},
        {"name": "ops-k8s-worker2", "ip": "10.77.0.46", "peer_asn": 4200000001, "description": "ops-k8s-worker2"},
        {"name": "ops-k8s-worker3", "ip": "10.77.0.47", "peer_asn": 4200000001, "description": "ops-k8s-worker3"},
        {"name": "dev-k8s-worker1", "ip": "10.77.0.48", "peer_asn": 4200000001, "description": "dev-k8s-worker1"},
        {"name": "dev-k8s-worker2", "ip": "10.77.0.49", "peer_asn": 4200000001, "description": "dev-k8s-worker2"},
        {"name": "dev-k8s-worker3", "ip": "10.77.0.50", "peer_asn": 4200000001, "description": "dev-k8s-worker3"},
        {"name": "lab-k8s-worker1", "ip": "10.77.0.51", "peer_asn": 4200000001, "description": "lab-k8s-worker1"},
        {"name": "lab-k8s-worker2", "ip": "10.77.0.52", "peer_asn": 4200000001, "description": "lab-k8s-worker2"},
        {"name": "lab-k8s-worker3", "ip": "10.77.0.53", "peer_asn": 4200000001, "description": "lab-k8s-worker3"},
        {"name": "isp-ipv4", "ip": "192.0.2.9", "peer_asn": 64500, "description": "ISP-IPv4"},
        {"name": "ops-k8s-control-ipv6", "ip": "2001:db8:0:ff::2", "peer_asn": 4200000001, "description": "ops-k8s-control-ipv6"},
        {"name": "dev-k8s-control-ipv6", "ip": "2001:db8:0:ff::3", "peer_asn": 4200000001, "description": "dev-k8s-control-ipv6"},
        {"name": "lab-k8s-control-ipv6", "ip": "2001:db8:0:ff::4", "peer_asn": 4200000001, "description": "lab-k8s-control-ipv6"},
        {"name": "ops-k8s-worker1-ipv6", "ip": "2001:db8:0:ff::5", "peer_asn": 4200000001, "description": "ops-k8s-worker1-ipv6"},
        {"name": "ops-k8s-worker2-ipv6", "ip": "2001:db8:0:ff::6", "peer_asn": 4200000001, "description": "ops-k8s-worker2-ipv6"},
        {"name": "ops-k8s-worker3-ipv6", "ip": "2001:db8:0:ff::7", "peer_asn": 4200000001, "description": "ops-k8s-worker3-ipv6"},
        {"name": "dev-k8s-worker1-ipv6", "ip": "2001:db8:0:ff::8", "peer_asn": 4200000001, "description": "dev-k8s-worker1-ipv6"},
        {"name": "dev-k8s-worker2-ipv6", "ip": "2001:db8:0:ff::9", "peer_asn": 4200000001, "description": "dev-k8s-worker2-ipv6"},
        {"name": "dev-k8s-worker3-ipv6", "ip": "2001:db8:0:ff::10", "peer_asn": 4200000001, "description": "dev-k8s-worker3-ipv6"},
        {"name": "lab-k8s-worker1-ipv6", "ip": "2001:db8:0:ff::11", "peer_asn": 4200000001, "description": "lab-k8s-worker1-ipv6"},
        {"name": "lab-k8s-worker2-ipv6", "ip": "2001:db8:0:ff::12", "peer_asn": 4200000001, "description": "lab-k8s-worker2-ipv6"},
        {"name": "lab-k8s-worker3-ipv6", "ip": "2001:db8:0:ff::13", "peer_asn": 4200000001, "description": "lab-k8s-worker3-ipv6"},
        {"name": "isp-ipv6", "ip": "2001:db8:ff:9::", "peer_asn": 64500, "description": "ISP-IPv6"}
      ]
    }
  },
  "storage": {
    "data_dir": "/var/lib/serviceradar/faker",
    "devices_file": "fake_armis_devices.json",
    "persist_changes": true
  },
  "logging": {
    "level": "info",
    "file": "/var/log/serviceradar/faker.log",
    "max_size": "100M",
    "max_backups": 5,
    "max_age": 30
  }
}

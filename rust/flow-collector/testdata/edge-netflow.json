{
  "listeners": [
    {
      "listen_addr": "0.0.0.0:2055",
      "protocol": "netflow",
      "subject": "flows.raw.netflow"
    }
  ],
  "nats_creds_file": "/etc/serviceradar/creds/flow-collector.creds",
  "nats_url": "tls://host01.example.com:4222",
  "partition": "site01",
  "security": {
    "cert_dir": "/etc/serviceradar/certs",
    "mode": "mtls",
    "tls": {
      "ca_file": "ca-chain.pem",
      "cert_file": "flow-collector.pem",
      "key_file": "flow-collector-key.pem"
    }
  },
  "stream_name": "flows",
  "stream_owner": false
}
